{
  "name": "@prospectbd/workflows",
  "version": "1.0.125",
  "description": "Shared Temporal workflows and utilities used across the organization's services.",
  "homepage": "https://github.com/gkibria121/price-engine-micro#readme",
  "bugs": {
    "url": "https://github.com/gkibria121/price-engine-micro/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gkibria121/daynightprint-shared-lib.git"
  },
  "license": "ISC",
  "author": "", 
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./common": {
      "import": "./dist/common/index.js",
      "types": "./dist/common/index.d.ts"
    },
    "./schema": {
      "import": "./dist/types/index.js",
      "types": "./dist/types/index.d.ts"
    },
    "./nest": {
      "import": "./dist/nest/index.js",
      "types": "./dist/nest/index.d.ts"
    }
  },
  "scripts": {
    "build": "bun run clean && tsc --build",
    "dev": "tsup src/index.ts --watch",
    "watch": "ts-node src/index.ts",
    "pub": "bun run build && npm version patch && npm publish --access public",
    "clean": "rm -rf dist *.tsbuildinfo",
    "lint": "eslint src --ext .ts,.tsx",
    "test": "bun test src"
  },
  "dependencies": {
    "@temporalio/workflow": "^1.15.0",
    "date-holidays": "^3.24.4",
    "moment": "^2.30.1",
    "pluralize": "^8.0.0"
  },
  "devDependencies": {
    "@temporalio/client": "^1.15.0",
    "@temporalio/worker": "^1.15.0",
    "@types/amqplib": "^0.10.7",
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^5.0.2",
    "@types/jest": "^29.5.14",
    "@types/node": "^25.5.2",
    "@types/supertest": "^6.0.3",
    "bun-types": "^1.3.11",
    "jest": "^29.7.0",
    "supertest": "^7.1.1",
    "ts-jest": "^29.3.4",
    "ts-node": "^10.9.2",
    "tsup": "^8.5.0",
    "typescript": "^5.3.3",
    "eslint": "^8.57.0",
    "eslint-plugin-import": "^2.31.0",
    "@typescript-eslint/parser": "^8.25.0",
    "@typescript-eslint/eslint-plugin": "^8.25.0",
    "eslint-import-resolver-typescript": "^4.4.4"
  },
  "peerDependencies": {
    "@nestjs/common": ">=11.0.0",
    "@nestjs/config": ">=4.0.0",
    "@nestjs/core": ">=11.0.0",
    "@nestjs/event-emitter": ">=3.0.0",
    "eventemitter2": ">=6.4.9",
    "zod": "^4.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
